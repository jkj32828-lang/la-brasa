{
  "hosting": [
    {
      "target": "cliente",
      "public": "public",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        { "source": "img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
      ]
    },
    {
      "target": "dono",
      "public": "public",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        { "source": "img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
